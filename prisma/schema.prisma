generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        Int      @id @default(autoincrement())
  fullname  String
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
